#!/usr/bin/env python3
"""Project adapter: test (DESIGN.md §4 — the only *required* adapter).

Contract: JSON payload on stdin (ignored by this stub), a single JSON object
`{"pass": bool, "summary": str}` on stdout, exit 0 — `run_adapter()`
(`maestro/adapters.py`) only trusts stdout as the result when the process itself
exits 0; a non-zero exit here means "the adapter could not determine a result",
which is exactly what a missing `tests/` directory means for a fresh, un-wired
project — reported as `nonzero_exit`, never silently treated as a pass.

`maestro init` renders the root-level command it can verify from project metadata.
An empty command means no supported root test signal was found; in that case this
adapter fails closed until the setup adviser or operator supplies the project policy.
"""
import json
import subprocess
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent.parent
TEST_COMMAND = {{ test_command_argv_json }}


def main() -> int:
    sys.stdin.read()  # drain the JSON payload; this stub takes no input fields

    if not TEST_COMMAND:
        print(
            "TODO: no test command was detected — replace this stub with the project's "
            "real required checks (see the module docstring in this file).",
            file=sys.stderr,
        )
        return 1

    proc = subprocess.run(
        TEST_COMMAND,
        cwd=str(PROJECT_ROOT),
        capture_output=True,
        text=True,
    )
    summary = (proc.stdout + proc.stderr).strip()[-4000:]
    print(json.dumps({"pass": proc.returncode == 0, "summary": summary}))
    return 0  # the *result* (pass/fail) lives in the JSON; this process succeeded either way


if __name__ == "__main__":
    sys.exit(main())

# /etc/systemd/system/{{ project_name }}-watchdog.service
#
# The service owns one named TMUX session directly.  This follows the operator's
# current generated-service contract: Type=forking with tmux as ExecStart, so the
# session remains auditable with `tmux attach -t {{ project_name }}-watchdog`.
#
# The unit's name matches what it runs: `maestro watchdog` (maestro/watchdog.py,
# extracted in M4b), which supervises the orchestrator and launches `maestro run`
# itself in the shared `agents` tmux session.
#
# TMUX owns the long-running process, so systemd cannot infer the watchdog's exit
# status.  RemainAfterExit keeps service ownership explicit; health/reconciliation
# must inspect the named session.  A HALT remains stopped until an operator clears
# the sentinel and restarts the unit.
[Unit]
Description={{ project_name }} — maestro watchdog (supervises the orchestrator loop)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
RemainAfterExit=yes
WorkingDirectory={{ systemd_repo_path }}
ExecStartPre=-/usr/bin/tmux kill-session -t {{ systemd_session }}
ExecStart=/usr/bin/tmux new-session -d -s {{ systemd_session }} -n main -c {{ systemd_repo_path }} {{ systemd_watchdog_command }}
ExecStop=-/usr/bin/tmux kill-session -t {{ systemd_session }}

[Install]
WantedBy=multi-user.target

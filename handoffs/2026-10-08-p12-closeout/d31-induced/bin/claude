#!/bin/bash
# D31 INDUCED FAULT — labelled, Dan approved 2026-10-08 ~08:15 IDT (P12 close-out).
# One-shot: the first `claude -p` launched from a DuetFlow directory while ARMED exists
# prints a real-format Claude usage-limit line and exits 1 WITHOUT calling the API.
# Everything else (and every later call) execs the real claude unchanged.
D=/home/dan/projects/maestro/handoffs/2026-10-08-p12-closeout/d31-induced
REAL=/home/dan/.local/bin/claude
if [ "$1" = "-p" ]; then
  case "$PWD" in
    /home/dan/projects/duetflow|/home/dan/projects/duetflow/*)
      if mv "$D/ARMED" "$D/FIRED" 2>/dev/null; then
        { echo "fired_at=$(date -u +%FT%TZ)"; echo "pwd=$PWD"; echo "ppid=$PPID";
          echo "argv_head=$(printf '%q ' "${@:1:12}" | cut -c1-600)"; } >> "$D/FIRED"
        echo "You've hit your limit · resets 1:10pm (Asia/Jerusalem)"
        exit 1
      fi ;;
  esac
fi
exec "$REAL" "$@"

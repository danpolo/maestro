# project.yaml — copied near-verbatim from DESIGN.md §5.
#
# `maestro init` renders this template by substituting the three placeholders below
# with what it derived from the target repo (git root, remote, main branch); nothing
# else in this file is placeholder-dependent, so init writes the rest unchanged.
# Placeholders are quoted so the unrendered template still parses as valid YAML
# (an unquoted `{{ ... }}` looks like a YAML flow mapping to a parser, not a string).
version: "2"
# Note: the adopted maestro version is runtime state, recorded in .orchestrator/state.json
# as `maestro_version` (DESIGN.md §9). It is deliberately NOT pinned here — see D5.

project:
  name: "{{ project_name }}"        # derives tmux session, systemd unit, /tmp paths
  repo_path: "{{ repo_path }}"
  remote: origin
  main_branch: "{{ main_branch }}"

roles:
  implementer:  {backend: claude, models: {claude: claude-sonnet-5, codex: gpt-5.6-terra}}
  judge:        {backend: claude, models: {claude: claude-opus-5,   codex: gpt-5.6-sol}}
  diagnoser:    {backend: claude, models: {claude: claude-opus-5,   codex: gpt-5.6-sol}}

fallback_chain: [claude, codex]

switch:
  on_quota_exhausted: true
  manual: true
  # `on_usage_threshold: {five_hour_pct, weekly_pct}` used to be declared here and was
  # never read by anything — an adopting project could set it and silently change nothing.
  # It also modelled the wrong shape: per-window limits cannot fire on an account whose
  # only window is the one you did not name (finding G5), which is why the enforced check
  # is window-agnostic — `SWITCH_THRESHOLD_PCT` (maestro/switch.py) against the
  # most-consumed window, whichever that is. Wire that constant to config before
  # re-declaring anything here.

model_limits:                   # D4 — defaults shown
  claude: ~/.claude/model_context_limits.md
  codex:  ~/.codex/model_context_limits.md

gate:                           # D8 — eval absent => test-only, journaled unevaluated
  chain: [test]
  primary_metric: null
  baseline_source: null
  bands: {claim: null, flat: null, block: null}

telegram:
  chat_id: <captured by init>
  # token lives in .env as TELEGRAM_BOT_TOKEN — never here, never committed

thresholds:
  five_h_pause_pct: 92
  concurrency_cap: 3
  switch_threshold_pct: 70  # Usage % at which to switch to a fallback backend; C3/G6b
  # context ceilings come from model_limits, not from here

risky_set: []
deny_list_extra: []             # REGEXES matched against diff TEXT (merge.deny_list_guard)
secrets: [".env", ".env.local", "**/*.pem", "**/*credentials*.json"]
prod_stores: []                 # production data stores — denied to every autonomous change
bot_files: []                   # this project's live-process source, if it runs one — a
                                 # merge that touches any of these hard-stops the resumable
                                 # auto-merge path (merge.py) and, once merged, canary-
                                 # deploys via this project's own scripts/canary_deploy.py

confinement:                    # what an autonomous change may touch (maestro/confinement.py)
  # `self_fix` repairs THIS project's orchestration setup after a failure it diagnosed.
  # It is not maestro's own package, which lives outside the repo. Default: the
  # scaffolding `init` creates, which is the only surface maestro can assume exists.
  self_fix_allow: [adapters/, profiles/, docs/]
  # `/redo` rewrites a deliverable Dan reported a problem with. Maestro cannot guess where
  # a project keeps those, so the default is deliberately narrow — widen it to your own
  # deliverable directories (a notebook folder, an export folder, ...) to make /redo useful.
  redo_allow: [docs/]
  # Path fragments (or globs) neither may touch, on top of `secrets` and `prod_stores`.
  deny: []
docs: {roadmap: docs/ROADMAP.md, project: docs/PROJECT.md, dependency_map: docs/dependency_map.md}

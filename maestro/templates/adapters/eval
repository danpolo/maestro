#!/usr/bin/env python3
"""Project adapter: eval (DESIGN.md §4, D8 — optional; absence is fine, but a
present-and-not-wired-up stub must say so honestly rather than fabricate a verdict).

Contract: JSON payload on stdin (ignored by this stub), a single JSON object
`{"metrics": {}, "baseline": {}, "deltas": {}, "verdict": "claim"|"flat"|"block",
"token_free": bool, "elapsed_s": float}` on stdout, exit 0.

This stub reports the D8 "unevaluated" state verbatim — the same honest signal an
*absent* eval adapter already gets from `run_adapter()` (status="absent"), just
spelled out in the verdict field for the present-but-not-yet-wired case. Replace
the body with a real eval harness once this project has one; until then `gate.chain`
should stay `[test]` (DESIGN.md §5) so `doctor` doesn't nag about an eval step that
isn't real yet.
"""
import json
import sys


def main() -> int:
    sys.stdin.read()  # drain the JSON payload; this stub takes no input fields
    print(json.dumps({
        "metrics": {},
        "baseline": {},
        "deltas": {},
        "verdict": "unevaluated",
        "token_free": True,
        "elapsed_s": 0,
    }))
    return 0


if __name__ == "__main__":
    sys.exit(main())

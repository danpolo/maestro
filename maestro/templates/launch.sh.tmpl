#!/usr/bin/env bash
# launch.sh — systemd wrapper for {{ project_name }}'s maestro loop.
#
# Same pattern as maestro's own scripts/maestro-build-launcher.sh: creates a
# dedicated, named tmux session so the loop is auditable from a phone with
# `tmux a -t {{ project_name }}-watchdog`, then blocks for a foreground/manual
# invocation. The generated Type=forking service owns the same session directly
# through its own tmux ExecStart and does not invoke this helper.
#
# What this runs (read before "fixing" it): `maestro watchdog`, the supervisor —
# NOT `maestro run`, the loop. The watchdog polls every 30s and launches
# `maestro run` itself, in a separate window of the shared `agents` tmux session,
# relaunching it whenever the orchestrator process dies. It also schedules the
# quota-reset resume, reaps dead implementer windows, and sets the HALT sentinel
# after three consecutive 20-minute stalls. Running `maestro run` here directly
# would lose all four: systemd only supervises this shell, so it fires on the
# tmux session ending, not on the orchestrator inside it dying.
#
# The watchdog exits on a stall-HALT (1), and on a `maestro ctl halt` HALT (0) only
# without a Telegram bot. With one it stays up while halted, answers /help and
# /status, and relaunches the loop as soon as HALT is removed. Stopping this systemd
# unit is the full stop.
set -euo pipefail

PROJECT_NAME="{{ project_name }}"
REPO_PATH="{{ repo_path }}"
SESSION="${PROJECT_NAME}-watchdog"

# Kill any stale session from a previous run (manual relaunch, prior boot, ...).
tmux kill-session -t "$SESSION" 2>/dev/null || true

# Launch the supervisor in a named, detached session. Source .env first (if present) so
# project application settings reach the watchdog and the `maestro run` it launches.
# Maestro startup overrides Telegram credentials from the shared ~/.maestro/.env;
# project processes read durable local mailboxes, served by `maestro telegram poll`.
#
# Bare `maestro` deliberately not used: a new tmux session/window's PATH comes from
# whatever environment the tmux *server* was started with, not this script's — not
# guaranteed to include this project's `.venv/bin` (confirmed empirically during a
# live M5 cutover). The absolute path to this project's own venv entrypoint is
# always resolvable, so `maestro/watchdog.py`'s own tmux spawns use the same fix.
tmux new-session -d -s "$SESSION" -n main -c "$REPO_PATH" \
    "set -a; [ -f '$REPO_PATH/.env' ] && source '$REPO_PATH/.env'; set +a; MAESTRO_REPO='$REPO_PATH' '$REPO_PATH/.venv/bin/maestro' watchdog"

# Block here; systemd tracks this shell as the "service process". When `maestro
# watchdog` exits (clean stop or crash) the session disappears and this loop ends.
# Note the watchdog's own exit code is swallowed by tmux — this script exits 0
# either way, so Restart=on-failure fires for a failure of the *launcher* (no tmux,
# bad REPO_PATH), not for the watchdog stopping. That is deliberate: a watchdog that
# stopped (a stall-HALT, or a halt with no bot) must stay stopped.
while tmux has-session -t "$SESSION" 2>/dev/null; do
    sleep 10
done
